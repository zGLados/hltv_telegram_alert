# Telegram Bot Token (from @BotFather) - required
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Timezone for "today", the daily summary and displayed match times
TIMEZONE=Europe/Berlin

# Time for the daily summary (format HH:MM, in TIMEZONE)
DAILY_SUMMARY_TIME=09:00

# Optional: database locations (defaults shown; Docker sets its own)
# DATABASE_PATH=data/bot_data.db
# INITIAL_DATABASE_PATH=data/initial_bot_data.db
# MATCH_CACHE_FILE=data/match_cache.json

# Optional: time of the daily match snapshot (HH:MM, in TIMEZONE)
# SNAPSHOT_TIME=06:00
